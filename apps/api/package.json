{
  "name": "@meujogo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run build --filter=@meujogo/api^... --output-logs=errors-only && nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@meujogo/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@meujogo/eslint-config": "workspace:*",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^24",
    "eslint": "^10",
    "typescript": "~6.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}
